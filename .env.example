# Copy to .env and fill in. Values here are placeholders, not credentials.
# Loaded by docker compose (env_file) and by `python3 server.py` after `set -a; . ./.env; set +a`.

# --- Platform credentials: set at least one token + its webhook secret ---
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Shared fallback used when the per-platform *_WEBHOOK_SECRET is unset.
WEBHOOK_SECRET=

# Optional: self-hosted GitLab / GitHub Enterprise base URLs (HTTPS required).
# GITLAB_URL=https://gitlab.example.com
# GITHUB_URL=https://github.example.com/api/v3

# --- Webhook server ---
BIND_HOST=0.0.0.0
# Public base URL the platforms call. Used by `make add` to create webhooks.
# PUBLIC_URL=https://reviewer.example.com
# Comma-separated list binds each port: 9877,9876
BIND_PORT=9877

# --- Hermes CLI ---
# Must be the real CLI. Default "hermes" resolves on PATH (Docker image: /opt/hermes/bin/hermes).
HERMES_BIN=hermes
# Optional model override for review runs; blank uses the profile default.
HERMES_MODEL=
# Optional Hermes profile (passed as -p); `make skill` installs into its skills dir.
# HERMES_PROFILE=
HERMES_SKILL=ai-code-reviewer
# Seconds per model call, and wall-clock budget for all calls of one chunked review.
HERMES_TIMEOUT_S=300
REVIEW_BUDGET_S=1200

# --- Concurrency: reviews run in a fixed pool; excess webhooks queue, then get 503 ---
MAX_WORKERS=4
QUEUE_SIZE=100

# --- Debate replies + auto-approve (GitLab). Blank BOT_USERNAME disables debate ---
BOT_USERNAME=
MIN_ACCESS_LEVEL=30
APPROVE_ACCESS_LEVEL=40
COOLDOWN_SECONDS=30
MAX_INLINE=20
# SQLite file of findings the bot conceded were wrong; fed back into later reviews of the
# same repo. Blank disables. LESSONS_IN_PROMPT caps how many reach one prompt.
MEMORY_DB=./reviewer.db
LESSONS_IN_PROMPT=10
# Chars of diff per model call; bigger diffs are reviewed in chunks, never rejected.
# Keep one chunk small enough to finish inside HERMES_TIMEOUT_S on your model.
MAX_DIFF=30000

# Optional allowlist: only these repos are reviewed (group/project or owner/repo).
# Blank = every repo whose webhook points here is reviewed. `make add REPO=…`
# appends to this list when it is already in use.
# REVIEW_REPOS=group/one,group/two

# --- Model provider keys used by the Hermes CLI (blank = configure in hermes-home/.env instead) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Docker only: host UID/GID that own ./hermes-home ---
HERMES_UID=1000
HERMES_GID=1000

# Dashboard: HTTP Basic login when a password is set; blank leaves it open.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=
# REVIEW_STORE=./reviews.jsonl
REVIEW_EST_S=60

# Retry a platform API call when the connection drops mid-review.
API_ATTEMPTS=3
