# Copy to .env and fill in. Values here are placeholders, not credentials.
# Loaded by docker compose (env_file) and by `python3 server.py` after `set -a; . ./.env; set +a`.

# --- Platform credentials: set at least one token + its webhook secret ---
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Shared fallback used when the per-platform *_WEBHOOK_SECRET is unset.
WEBHOOK_SECRET=

# Optional: self-hosted GitLab / GitHub Enterprise base URLs (HTTPS required).
# GITLAB_URL=https://gitlab.example.com
# GITHUB_URL=https://github.example.com/api/v3

# --- Webhook server ---
BIND_HOST=0.0.0.0
# Comma-separated list binds each port: 9877,9876
BIND_PORT=9877

# --- Hermes CLI ---
# Must be the real CLI. Default "hermes" resolves on PATH (Docker image: /opt/hermes/bin/hermes).
HERMES_BIN=hermes
# Optional model override for review runs; blank uses the profile default.
HERMES_MODEL=
HERMES_SKILL=ai-code-reviewer
HERMES_TIMEOUT_S=300

# --- Concurrency: reviews run in a fixed pool; excess webhooks queue, then get 503 ---
MAX_WORKERS=4
QUEUE_SIZE=100

# --- Model provider keys used by the Hermes CLI (blank = configure in hermes-home/.env instead) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Docker only: host UID/GID that own ./hermes-home ---
HERMES_UID=1000
HERMES_GID=1000
